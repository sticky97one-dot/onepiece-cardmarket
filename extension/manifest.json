{
  "manifest_version": 3,
  "name": "Radar Whatnot One Piece",
  "version": "1.1.0",
  "description": "Pendant un live Whatnot, repère la carte One Piece en vente et affiche jusqu'où enchérir d'après les prix Cardmarket du jour.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.anthropic.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "https://whatnot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}